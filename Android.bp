soong_namespace {
    imports: [
        "hardware/google/interfaces",
        "hardware/google/pixel",
        "hardware/lineage/interfaces/power-libperfmgr",
        "hardware/qcom-caf/common/libqti-perfd-client",
        "hardware/motorola",
    ],
}

install_symlink {
    name: "firmware_wlanmdsp.otaupdate_symlink",
    soc_specific: true,
    installed_location: "firmware/wlanmdsp.otaupdate",
    symlink_target: "/data/vendor/firmware/wlanmdsp.mbn",
}

install_symlink {
    name: "firmware_adrastea_wlan_mac.bin_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/adrastea/wlan_mac.bin",
    symlink_target: "/mnt/vendor/persist/adrastea/wlan_mac.bin",
}

install_symlink {
    name: "firmware_adrastea_WCNSS_qcom_cfg.ini_symlink",
    vendor: true,
    installed_location: "firmware/wlan/qca_cld/adrastea/WCNSS_qcom_cfg.ini",
    symlink_target: "/vendor/etc/wifi/adrastea/WCNSS_qcom_cfg.ini",
}

cc_prebuilt_library_shared {
    name: "libv4a_aidl",
    owner: "oneplus",
    vendor: true,
    relative_install_path: "soundfx",
    srcs: ["viper/lib64/soundfx/libv4a_aidl.so"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    check_elf_files: false,
}

android_app_import {
    name: "ViPER4Android",
    apk: "viper/app/ViPER4Android/ViPER4Android.apk",
    product_specific: true,
    presigned: true,
    preprocessed: true,
}
